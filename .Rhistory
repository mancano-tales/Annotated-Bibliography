# Run again — a correct idempotent script should update 0 files on a second pass
results2 <- map_lgl(files, fix_file_categories, mapping = mapping, dry_run = FALSE)
cat(sprintf("Second pass: updated %d / %d files.\n", sum(results2), length(files)))
# Trace what's changing in a single file to find the bug
test_file <- files[1]
lines    <- readLines(test_file, warn = FALSE, encoding = "UTF-8")
yaml_end <- which(lines == "---")
yaml_block <- lines[seq_len(yaml_end[2])]
parsed   <- parse_categories(yaml_block)
new_items <- remap_items(parsed$items, mapping)
cat("File:", basename(test_file), "\n")
cat("Original items:", paste(parsed$items, collapse = " | "), "\n")
cat("New items:     ", paste(new_items,     collapse = " | "), "\n")
cat("Identical:     ", identical(new_items, parsed$items), "\n")
cat("Type:", parsed$type, "\n")
# Encoding issue — inspect raw bytes
cat("Parsed items (repr):\n")
for (item in parsed$items) cat(sprintf("  [%s] nchar=%d\n", item, nchar(item)))
cat("\nNew items (repr):\n")
for (item in new_items) cat(sprintf("  [%s] nchar=%d\n", item, nchar(item)))
# Show raw hex for the first item that differs
diffs <- which(parsed$items != new_items)
if (length(diffs) > 0) {
cat("\nDiffering at index:", diffs, "\n")
} else {
# Check if the difference is in the vector itself
cat("\ncharEqual check:\n")
cat("lengths:", length(parsed$items), length(new_items), "\n")
for (i in seq_along(parsed$items)) {
eq <- parsed$items[i] == new_items[i]
cat(sprintf("  [%d] %s == %s : %s\n", i, parsed$items[i], new_items[i], eq))
}
}
cat("names(parsed$items):", paste(names(parsed$items), collapse=", "), "\n")
cat("names(new_items):   ", paste(names(new_items),    collapse=", "), "\n")
