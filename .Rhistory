path <- "C:/Users/Mancano/Documents/MancanoSync/Annotated-Bibliography/posts/Fernandes2005.qmd"
lines <- readLines(path, encoding = "UTF-8")
in_yaml  <- FALSE
in_code  <- FALSE
changed  <- integer(0)
clean <- vapply(seq_along(lines), function(i) {
line <- lines[i]
# YAML frontmatter (bounded by the first two "---")
if (i == 1 && line == "---") { in_yaml <<- TRUE; return(line) }
if (in_yaml && line == "---") { in_yaml <<- FALSE; return(line) }
if (in_yaml) return(line)
# code blocks
if (grepl("^```", line)) { in_code <<- !in_code; return(line) }
if (in_code) return(line)
# remove a single leading space (preserve 2+ spaces = intentional indent)
if (startsWith(line, " ") && !startsWith(line, "  ")) {
changed <<- c(changed, i)
return(sub("^ ", "", line))
}
line
}, character(1))
cat("Linhas alteradas:", length(changed), "\n")
cat("Exemplos (primeiras 10):\n")
print(cbind(antes = lines[head(changed, 10)], depois = clean[head(changed, 10)]))
writeLines(clean, path, useBytes = FALSE)
cat("Arquivo salvo com sucesso.\n")
