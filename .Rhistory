fix_patch <- function(filepath, patch) {
lines <- readLines(filepath, warn = FALSE, encoding = "UTF-8")
yaml_end <- which(lines == "---")
if (length(yaml_end) < 2) return(FALSE)
original <- lines
yaml_range <- seq_len(yaml_end[2])
yaml_block <- lines[yaml_range]
for (old in names(patch)) {
yaml_block <- str_replace_all(yaml_block, fixed(old), patch[[old]])
}
# Deduplicate inline categories
cat_start <- which(startsWith(trimws(yaml_block), "categories:"))
if (length(cat_start) > 0) {
inline <- str_match(yaml_block[cat_start], "^categories:\\s*\\[(.+)\\]")[, 2]
if (!is.na(inline)) {
cats <- str_split(inline, ",")[[1]] |> str_trim() |> unique()
yaml_block[cat_start] <- paste0("categories: [", paste(cats, collapse = ", "), "]")
}
}
lines[yaml_range] <- yaml_block
if (!identical(lines, original)) {
writeLines(lines, filepath, useBytes = FALSE)
return(TRUE)
}
return(FALSE)
}
files <- list.files(posts_dir, pattern = "\\.qmd$", full.names = TRUE)
patch_results <- map_lgl(files, fix_patch, patch = patch)
cat(sprintf("Patched: %d files\n", sum(patch_results)))
# Final verification pass
