fix_file_categories <- function(filepath, mapping) {
lines <- readLines(filepath, warn = FALSE, encoding = "UTF-8")
yaml_end <- which(lines == "---")
if (length(yaml_end) < 2) return(FALSE)
original <- lines
yaml_range <- seq_len(yaml_end[2])
yaml_block <- lines[yaml_range]
for (old in names(mapping)) {
yaml_block <- str_replace_all(yaml_block, fixed(old), mapping[[old]])
}
# Deduplicate inline categories: [A, B, B] → [A, B]
cat_start <- which(startsWith(trimws(yaml_block), "categories:"))
if (length(cat_start) > 0) {
inline <- str_match(yaml_block[cat_start], "^categories:\\s*\\[(.+)\\]")[, 2]
if (!is.na(inline)) {
cats <- str_split(inline, ",")[[1]] |> str_trim() |> unique()
yaml_block[cat_start] <- paste0("categories: [", paste(cats, collapse = ", "), "]")
}
}
lines[yaml_range] <- yaml_block
if (!identical(lines, original)) {
writeLines(lines, filepath, useBytes = FALSE)
return(TRUE)
}
return(FALSE)
}
files <- list.files(posts_dir, pattern = "\\.qmd$", full.names = TRUE)
results <- map_lgl(files, fix_file_categories, mapping = mapping)
cat(sprintf("✅ Updated %d / %d files.\n", sum(results), length(files)))
# Quick sanity check: extract categories from all posts and show what's left
extract_categories <- function(filepath) {
lines <- readLines(filepath, warn = FALSE)
yaml_end <- which(lines == "---")
if (length(yaml_end) < 2) return(tibble(file = basename(filepath), category = NA_character_))
yaml_lines <- lines[1:yaml_end[2]]
cat_start <- which(str_detect(yaml_lines, "^categories\\s*:"))
if (length(cat_start) == 0) return(tibble(file = basename(filepath), category = NA_character_))
inline <- str_match(yaml_lines[cat_start], "^categories\\s*:\\s*\\[(.+)\\]")[, 2]
if (!is.na(inline)) {
cats <- str_split(inline, ",")[[1]] |> str_trim()
return(tibble(file = basename(filepath), category = cats))
}
rest <- yaml_lines[(cat_start + 1):length(yaml_lines)]
list_items <- rest[str_detect(rest, "^\\s+-\\s+")]
if (length(list_items) == 0) return(tibble(file = basename(filepath), category = NA_character_))
cats <- str_remove(list_items, "^\\s+-\\s+") |> str_trim()
tibble(file = basename(filepath), category = cats)
}
files <- list.files(posts_dir, pattern = "\\.qmd$", full.names = TRUE)
final_cats <- map_dfr(files, extract_categories) |> filter(!is.na(category))
# Show remaining non-English or Portuguese-looking categories
suspicious <- final_cats |>
filter(str_detect(category, "[áéíóúãõâêîôûàèìòùçÁÉÍÓÚÃÕÂÊÎÔÛÀÈÌÒÙÇ]") |
str_detect(category, "^(Comparative Political Economy|Politics of Education|Social Policy|Welfare State|Privatization|Education Policy)$")) |>
count(category, sort = TRUE)
if (nrow(suspicious) == 0) {
cat("✅ No remaining Portuguese or outdated canonical categories found.\n")
} else {
cat("⚠️  Categories still needing attention:\n")
print(suspicious)
}
cat("\nTotal unique categories now in use:", n_distinct(final_cats$category), "\n")
