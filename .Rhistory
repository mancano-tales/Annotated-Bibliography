"Education Policy/Politics/Politics"         = "Education Policy/Politics",
"Latin America Comparada"                    = "Latin America"
)
files <- list.files(posts_dir, pattern = "\\.qmd$", full.names = TRUE)
patch2_results <- map_lgl(files, fix_patch, patch = patch2)
cat(sprintf("Patched: %d files\n", sum(patch2_results)))
extract_categories <- function(filepath) {
lines <- readLines(filepath, warn = FALSE)
yaml_end <- which(lines == "---")
if (length(yaml_end) < 2) return(tibble(file = basename(filepath), category = NA_character_))
yaml_lines <- lines[1:yaml_end[2]]
cat_start <- which(str_detect(yaml_lines, "^categories\\s*:"))
if (length(cat_start) == 0) return(tibble(file = basename(filepath), category = NA_character_))
inline <- str_match(yaml_lines[cat_start], "^categories\\s*:\\s*\\[(.+)\\]")[, 2]
if (!is.na(inline)) {
cats <- str_split(inline, ",")[[1]] |> str_trim()
return(tibble(file = basename(filepath), category = cats))
}
rest <- yaml_lines[(cat_start + 1):length(yaml_lines)]
list_items <- rest[str_detect(rest, "^\\s+-\\s+")]
if (length(list_items) == 0) return(tibble(file = basename(filepath), category = NA_character_))
cats <- str_remove(list_items, "^\\s+-\\s+") |> str_trim()
tibble(file = basename(filepath), category = cats)
}
final_cats <- map_dfr(files, extract_categories) |> filter(!is.na(category))
# Check for any remaining artifacts
artifacts <- final_cats |>
filter(
str_detect(category, "[áéíóúãõâêîôûàèìòùçÁÉÍÓÚÃÕÂÊÎÔÛÀÈÌÒÙÇ]") |
str_detect(category, "Comparada|Comparad") |
str_detect(category, "Politics Politics|Policy/Politics/Politics") |
str_detect(category, "Welfare State/Welfare") |
str_detect(category, "^(Social Policy|Welfare State|Privatization|Education Policy|Comparative Political Economy|Politics of Education)$")
) |>
count(category, sort = TRUE)
if (nrow(artifacts) == 0) {
cat("✅ All categories clean — no artifacts or Portuguese terms remaining.\n")
} else {
cat("⚠️  Remaining issues:\n")
print(artifacts, n = Inf)
}
cat("\nFinal unique category count:", n_distinct(final_cats$category), "\n")
cat("\nTop 25:\n")
final_cats |> count(category, sort = TRUE) |> print(n = 25)
patch3 <- c(
"Economia Política da Educação" = "Education Policy/Politics",
"Educação Superior"             = "Higher Education",
"Política Educacional"          = "Education Policy/Politics",
"Privatização"                  = "Private Education",
"Sociologia da Educação"        = "Sociology of Education"
)
patch3_results <- map_lgl(files, fix_patch, patch = patch3)
cat(sprintf("Patched: %d files\n", sum(patch3_results)))
# Final clean check
final_cats2 <- map_dfr(files, extract_categories) |> filter(!is.na(category))
remaining <- final_cats2 |>
filter(str_detect(category, "[áéíóúãõâêîôûàèìòùçÁÉÍÓÚÃÕÂÊÎÔÛÀÈÌÒÙÇ]")) |>
count(category, sort = TRUE)
if (nrow(remaining) == 0) {
cat("✅ All clean. Final unique category count:", n_distinct(final_cats2$category), "\n")
} else {
cat("⚠️  Still remaining:\n")
print(remaining, n = Inf)
}
