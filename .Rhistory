# ── Helper: rewrite categories in a single .qmd file ──────────────────────
fix_file_categories <- function(filepath, mapping, dry_run = FALSE) {
lines <- readLines(filepath, warn = FALSE, encoding = "UTF-8")
yaml_end <- which(lines == "---")
if (length(yaml_end) < 2) return(invisible(NULL))
original <- lines
# Apply every substitution inside the YAML block only
yaml_range <- seq_len(yaml_end[2])
yaml_block <- lines[yaml_range]
for (old in names(mapping)) {
new <- mapping[[old]]
# Match as a whole word/phrase within the YAML (inline or list item)
yaml_block <- str_replace_all(
yaml_block,
fixed(old),
new
)
}
# After substitution, deduplicate categories that may now be identical
# Find categories block
cat_start <- which(str_detect(yaml_block, "^categories\s*:"))
source("C:/Users/Mancano/Documents/MancanoSync/Annotated-Bibliography/fix_categories.R")
